# Copia este archivo a .env y completa los valores
# NO subas el archivo .env real a GitHub (está en .gitignore)

# Clave secreta Flask - GENERA UNA NUEVA:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu-clave-secreta-super-segura-aqui

# OpenAI API Key (opcional) - Para frases IA en cotizaciones
# Obtén la tuya en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu-api-key-aqui

# Puerto (Render lo asigna automáticamente, no tocar)
# PORT=5000